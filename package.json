{
  "name": "dsh-model-protocol-matrix",
  "version": "0.2.0",
  "description": "Per-model wire protocol for DeepSeek Harness: compile model-level protocol intent into legal llm-pi-ai routes, probe all three protocols, hide unusable models. Mutually exclusive with dsh-gearbox.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "locale",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haodanhui521/dsh-model-protocol-matrix.git"
  },
  "license": "MIT"
}
